# Адрес сервера Selfvoy для сборки веб/мобильного/десктоп-клиента (скопируйте в .env).
# Переменные читаются при `npm run build`, в готовом приложении их не поменять —
# для этого есть «Адрес сервера» на экране входа и в настройках.

# Основной адрес: продакшн — wss:// за TLS-прокси.
# Пусто — платформенный дефолт: Android-эмулятор → ws://10.0.2.2:9000,
# остальное → ws://127.0.0.1:9000. Телефону нужен IP компьютера: ws://192.168.x.x:9000.
VITE_SELFVOY_SERVER_URL=

# Запасной адрес: клиент переключается на него сам, если основной не отвечает.
VITE_SELFVOY_FALLBACK_URL=
