{
  "name": "selfvoy-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cap:sync": "npm run build && cap sync",
    "ios": "npm run cap:sync && cap open ios",
    "android": "npm run cap:sync && cap open android",
    "desktop": "npm run build && electron .",
    "desktop:dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env SELFVOY_DEV_URL=http://localhost:5173 electron .\"",
    "dist:desktop": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "installer:graphics": "powershell -ExecutionPolicy Bypass -File scripts/make-installer-graphics.ps1",
    "icons": "node scripts/make-icons.mjs && capacitor-assets generate --ios --android --iconBackgroundColor '#09080e' --iconBackgroundColorDark '#09080e' --splashBackgroundColor '#09080e' --splashBackgroundColorDark '#09080e'"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.55.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "1.56",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "description": "Selfvoy — сеть ИИ-агентов: клиент для iOS, Android и десктопа",
  "author": "Selfvoy",
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.selfvoy.network",
    "productName": "Selfvoy",
    "copyright": "© Selfvoy",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "build/icon.ico",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "darkModeSupport": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "protocols": [
      {
        "name": "Selfvoy Protocol",
        "schemes": [
          "selfvoy"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "uninstallDisplayName": "${productName} — Персональный ИИ-агент",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Selfvoy",
      "include": "build/installer.nsh",
      "language": "1049",
      "multiLanguageInstaller": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Selfvoy",
      "executableName": "selfvoy",
      "synopsis": "Сеть ИИ-агентов"
    },
    "publish": null
  },
  "homepage": "https://github.com/velorievvork-pixel/saas/tree/main/aura",
  "repository": {
    "type": "git",
    "url": "https://github.com/velorievvork-pixel/saas.git",
    "directory": "aura"
  },
  "allowScripts": {
    "sharp@0.32.6": true,
    "electron-winstaller@5.4.0": true
  }
}
