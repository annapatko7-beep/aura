# ==============================================================================
# Selfvoy Android Release Signing Configuration Example
# ==============================================================================
# Скопируйте этот файл в web/android/keystore.properties:
#   cp web/android/keystore.properties.example web/android/keystore.properties
#
# Генерация нового релизного ключа (RSA 2048+ бит, срок действия 25+ лет):
#   keytool -genkey -v -keystore release-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias selfvoy
# ==============================================================================

# Относительный или абсолютный путь к файлу .jks (если в папке web/android/app — 'release-key.jks')
storeFile=release-key.jks
storePassword=your_keystore_password
keyAlias=selfvoy
keyPassword=your_key_password
