# Aura — шаблон секретов и настроек прода.
#
# КАК ПОЛЬЗОВАТЬСЯ (секреты мне в чат присылать НЕ нужно):
#   1. на своей машине:  git clone https://github.com/annapatko7-beep/aura && cd aura
#   2. cp .env.example .env   и заполните значения ниже
#      (сгенерировать секреты:  openssl rand -hex 32)
#   3. make up  (или: docker compose up -d)
#
# .env в git не попадает. Всё незаполненное работает в dev-режиме
# (mock-LLM, коды подтверждения в логах, push в лог).

# --- обязательно для прода -------------------------------------------------
AURA_JWT_SECRET=            # случайная строка, напр. openssl rand -hex 32
AURA_2FA_KEY=               # случайная строка (32+ символов) — шифрование TOTP-секретов
POSTGRES_PASSWORD=          # пароль БД (используется и в DATABASE_URL внутри compose)
AURA_AI_TOKEN=              # токен между C++-сервером и AI-сервисом (любая случайная строка)

# --- LLM (без этого агент отвечает mock-ом) --------------------------------
AURA_LLM_PROVIDER=openai    # mock | openai
OPENAI_API_KEY=             # ключ OpenAI-совместимого провайдера
OPENAI_BASE_URL=            # если провайдер не OpenAI — его base URL
AURA_LLM_MODEL=             # напр. gpt-4o-mini

# --- Google OAuth (календарь + Gmail) --------------------------------------
# В Cloud Console: OAuth Client (тип Desktop или Web), в Authorized redirect
# URI добавить  aura://oauth  (для мобильных клиентов).
AURA_GOOGLE_CLIENT_ID=
AURA_GOOGLE_CLIENT_SECRET=

# --- Push -------------------------------------------------------------------
# Сервер сам не терминирует TLS — доставка через ваш шлюз (docs/SETUP.md §push):
AURA_PUSH_DRIVER=dev        # dev | webhook
AURA_PUSH_WEBHOOK_URL=      # https://ваш-шлюз/push  (форвардит в APNs и FCM)
AURA_APNS_TOPIC=ai.aura.app
AURA_FCM_URL=https://fcm.googleapis.com/v1/projects/ВАШ-ПРОЕКТ/messages:send

# --- Речь и память (опционально) --------------------------------------------
AURA_STT_PROVIDER=mock      # mock | whisper-совместимый URL ниже
AURA_STT_URL=
AURA_STT_API_KEY=
AURA_EMBEDDINGS_URL=        # семантический RAG памяти (опционально)
AURA_EMBEDDINGS_API_KEY=

# --- Почта (прода; по умолчанию dev — коды видны в логах) -------------------
AURA_MAIL_DRIVER=dev        # dev | http
AURA_EMAIL_API_URL=         # эндпоинт вашего почтового API (Resend/SendGrid/…)
