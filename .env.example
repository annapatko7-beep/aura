# Шаблон .env для docker-compose и локального запуска.
# Скопируйте в .env (он в .gitignore, в git не коммитить) и заполните секреты.
# Пустой секрет = compose откажется стартовать (${VAR:?} в docker-compose.yml).
#
# Генерация каждого секрета (hex — безопасно вставлять в URL БД):
#   openssl rand -hex 32
# Значения из документации/примеров не использовать: сервер отклоняет
# известные дефолтные секреты.
#
# Переименование продукта: прежние имена AURA_* сервер и AI-сервис ещё один
# релиз читают как запасные (если SELFVOY_* не задана; в логе — предупреждение).
# docker-compose.yml передаёт только SELFVOY_* — в .env пишите новые имена.

# ========== КРИТИЧНЫЕ СЕКРЕТЫ (обязательны) ==========
# Подпись JWT (C++-сервер)
SELFVOY_JWT_SECRET=
# Ключ шифрования TOTP-секретов и токенов интеграций; после запуска не менять
SELFVOY_2FA_KEY=
# Общий секрет C++-сервер <-> AI-сервис (заголовок X-Selfvoy-Token).
# Без него AI-сервис отвечает 503 (fail closed).
SELFVOY_AI_TOKEN=

# ========== PostgreSQL (docker-compose) ==========
# Суперпользователь postgres — только для инициализации/обслуживания
POSTGRES_PASSWORD=
# Роль selfvoy_app (C++-сервер, только DML) и selfvoy_ai (AI-сервис, только память);
# создаются deploy/postgres/20-app-roles.sh при первом старте пустого тома
SELFVOY_DB_PASSWORD=
SELFVOY_AI_DB_PASSWORD=

# ========== Режим разработки ==========
# SELFVOY_DEV_MODE=1 — только локальная разработка (слабые/сгенерированные
# секреты, dev-почта с кодом в ответе API). В production НЕ задавать.
# SELFVOY_DEV_MODE=1
# SELFVOY_AI_INSECURE_DEV=1 — AI-сервис без SELFVOY_AI_TOKEN (только localhost,
# make ai-run ставит его сам). В production НЕ задавать.
# SELFVOY_AI_INSECURE_DEV=1

# ========== AI Service ==========
SELFVOY_LLM_PROVIDER=mock
# Для работы с реальным LLM раскомментируйте:
# OPENAI_API_KEY=
# SELFVOY_LLM_MODEL=gpt-4o-mini
# Другой OpenAI-совместимый провайдер: его адрес (пусто — api.openai.com).
# OPENAI_BASE_URL=
# Проверка, что модель отвечает: make llm-check (локально) или selfvoy llm-check (сервер).
SELFVOY_RAG_MODE=auto

# ========== Локальный запуск без compose (make server-run / ai-run) ==========
# В compose адреса БД и AI задаются в docker-compose.yml.
# SELFVOY_DATABASE_URL=postgresql://selfvoy_app:<пароль>@localhost/selfvoy
# Соединений с PostgreSQL у сервера (пул; 1–64, по умолчанию 8).
# SELFVOY_DB_POOL_SIZE=8
# PG_URI=postgresql://postgres:<пароль>@localhost/selfvoy
# SELFVOY_AI_URL=http://127.0.0.1:8000
# SELFVOY_MEMORY_BACKEND=file
# SELFVOY_CORS_ORIGINS=http://localhost:9000

# ========== Сеть ==========
# Адрес публикации порта 9000 в compose (127.0.0.1 — только за локальным TLS-прокси)
# SELFVOY_BIND=0.0.0.0
SELFVOY_MAX_CONNECTIONS=1024

# ========== Почта: коды подтверждения и сброса пароля ==========
# smtp — настоящая отправка; log (по умолчанию в compose) — только запись в лог
# (без кодов); dev — код в ответе API (только локальная разработка, вместе с
# SELFVOY_DEV_MODE=1).
SELFVOY_MAIL_DRIVER=smtp
SELFVOY_SMTP_HOST=smtp.example.com
# 587 + starttls (по умолчанию) или 465 + tls; none — только локальный ретранслятор
SELFVOY_SMTP_PORT=587
SELFVOY_SMTP_TLS=starttls
SELFVOY_SMTP_USER=
SELFVOY_SMTP_PASSWORD=
SELFVOY_SMTP_FROM=Selfvoy <no-reply@example.com>
# SELFVOY_SMTP_CA_FILE=/etc/ssl/certs/own-ca.pem

# ========== Push-уведомления ==========
SELFVOY_PUSH_DRIVER=dev
# Для production через webhook (или внутренний push-gateway):
# SELFVOY_PUSH_DRIVER=webhook
# SELFVOY_PUSH_WEBHOOK_URL=http://push-gateway:8080/push
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_KEY_PATH=
# FCM_PROJECT_ID=
# FCM_ACCESS_TOKEN=

# ========== Геолокация и поиск мест (OSM / Maps) ==========
# Адрес сервиса поиска кафе/ресторанов для встреч Аур (по умолчанию эндпоинт AI-сервиса)
# SELFVOY_MAPS_API_URL=http://ai:8000/v1/places/search

# ========== Бронирование мест (Aura Booking Engine) ==========
# SELFVOY_BOOKING_API_URL=http://ai:8000/v1/tools/book_table
# Вебхук ресторанного агрегатора или бота ресторана:
# SELFVOY_BOOKING_WEBHOOK_URL=https://booking-aggregator.example.com/api/reserve

# ========== Межагентная федерация (Aura Federation Protocol / AFP v1.0) ==========
# 64-символьный hex Ed25519 приватного ключа узла (если пусто — генерируется при старте)
# AURA_FEDERATION_PRIVATE_KEY=


# ========== Google OAuth (опционально) ==========
# SELFVOY_GOOGLE_CLIENT_ID=
# SELFVOY_GOOGLE_CLIENT_SECRET=

# ========== Rate Limiting ==========
SELFVOY_MAX_LOGIN_ATTEMPTS=8
SELFVOY_LOGIN_WINDOW=300

# ========== Логи ==========
SELFVOY_LOG_LEVEL=info

# ========== Приглашения по ссылке ==========
# Адрес веб-клиента: invite.create вернёт https://selfvoy.example.com/#/i/<токен>.
SELFVOY_PUBLIC_URL=

# ========== ICS-подписка (календарь владельца) ==========
# Внешний адрес самого сервера (тот же хост, что у wss://), например
# https://api.example.com: calendar.feedReset вернёт https://api.example.com/ics/<токен>.ics.
# Пусто — клиент собирает адрес из адреса сервера (wss→https, ws→http).
SELFVOY_SERVER_PUBLIC_URL=

# ========== Админ-панель ==========
# Email первых администраторов через запятую. Роль admin выдаётся только
# подтверждённому адресу (при старте сервера и при входе).
SELFVOY_ADMIN_EMAILS=

# ========== Тариф Pro ==========
# 0 (по умолчанию, бета) — функции Pro открыты всем; 1 — нужен действующий Pro
# (admin.setPlan или «selfvoy pro EMAIL ДНЕЙ»), иначе ошибка pro_required.
SELFVOY_PLANS_ENFORCED=

# ========== Telegram-бот (F2) ==========
# Токен от @BotFather и имя бота без @. Без обоих бот выключен (ссылок нет).
SELFVOY_TELEGRAM_BOT_TOKEN=
SELFVOY_TELEGRAM_BOT_USERNAME=
# Адрес Bot API (по умолчанию https://api.telegram.org; e2e — http-мок).
# SELFVOY_TELEGRAM_API_URL=
# 0 — не опрашивать getUpdates (только отправка; опрашивает другой экземпляр).
# SELFVOY_TELEGRAM_POLL=
# Свой корневой сертификат для исходящих https-запросов (Telegram, Google, ЮKassa).
# SELFVOY_CA_FILE=

# ========== Оплата записи: ЮKassa (F4) ==========
# Владелец подключает свой магазин сам (payments.connect: shop_id + секретный ключ,
# ключ хранится зашифрованным ключом SELFVOY_2FA_KEY). Серверу нужен только адрес API
# (по умолчанию https://api.yookassa.ru/v3; e2e — http-мок) и SELFVOY_PUBLIC_URL —
# адрес возврата гостя после оплаты. Чеки 54-ФЗ: «Мой налог» или настройки магазина.
# SELFVOY_YOOKASSA_API_URL=

# ========== Обратный прокси ==========
# IP TLS-прокси через запятую: от них адрес клиента берётся из X-Forwarded-For.
# SELFVOY_TRUSTED_PROXIES=172.18.0.1

# E2E-сценарий админ-панели (tools/e2e.py): тот же адрес должен быть в SELFVOY_ADMIN_EMAILS.
# SELFVOY_E2E_ADMIN_EMAIL=
# SELFVOY_E2E_ADMIN_PASSWORD=

# ========== E2E тесты (моки для CI) ==========
# SELFVOY_E2E_GOOGLE_MOCK=1
# SELFVOY_E2E_PUSH_MOCK=1
