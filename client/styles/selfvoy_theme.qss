/* ==========================================================================
   selfvoy_theme.qss — Dark Glassmorphism для варианта Qt Widgets.

   Дизайн-система v3 (макеты 30.09.2026). Для Qt Quick/QML используйте
   client/qml/theme/SelfvoyTheme.qml, для веб-превью — preview/styles.css:
   значения совпадают один в один.

   Примечание: backdrop-filter в Qt Widgets нет. Варианты: Qt Quick (QML) +
   ShaderEffect, QWebEngineView, либо имитация через полупрозрачный QPixmap +
   QGraphicsBlurEffect. Ниже — непрозрачная «стеклянная» имитация.
   ========================================================================== */

QMainWindow, QWidget#Root {
    background: qradialgradient(cx:0.3, cy:0.2, radius:1,
        stop:0 #0f0d17, stop:1 #09080e);
}

QFrame.GlassCard {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 24px;
}
QFrame.GlassCard:hover {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
}

QPushButton.BubbleBtn {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 24px;
    padding: 12px 24px;
    color: #f4f1fb;
    font-size: 14px;
}
QPushButton.BubbleBtn:hover {
    background: rgba(255,255,255,0.10);
    border-color: rgba(255,255,255,0.18);
}
QPushButton.BubbleBtn:pressed {
    background: rgba(255,255,255,0.14);
}

QPushButton.AccentBtn {
    background: #8b5cf6;
    border: none;
    border-radius: 24px;
    padding: 14px 28px;
    color: #fff;
    font-weight: 600;
}
QPushButton.AccentBtn:hover { background: #a77bff; }

QLineEdit, QComboBox, QTextEdit {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 14px;
    padding: 10px 14px;
    color: #f4f1fb;
    selection-background-color: rgba(139,92,246,0.4);
}
QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #8b5cf6;
    background: rgba(255,255,255,0.12);
}

QLabel { color: #f4f1fb; }
QLabel[role="secondary"] { color: #b9b3c9; }
QLabel[role="tertiary"] { color: #7d768f; }
