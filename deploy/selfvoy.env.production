# ==============================================================================
# Selfvoy Production Environment Configuration Template
# ==============================================================================
# Скопируйте этот файл в .env на сервере:
#   cp deploy/selfvoy.env.production .env
# Сгенерируйте криптостойкие секреты:
#   openssl rand -hex 32
# ==============================================================================

# --- 1. ДОМЕН И СЕТЬ (WSS / HTTPS / Caddy) -----------------------------------
# Публичный домен вашего сервера (без https:// и без порта).
# Caddy автоматически получит SSL-сертификат Let's Encrypt для этого домена.
SELFVOY_DOMAIN=api.yourdomain.com
SELFVOY_PUBLIC_URL=https://api.yourdomain.com
SELFVOY_SERVER_PUBLIC_URL=wss://api.yourdomain.com

# Порт прослушивания сервера внутри сети (по умолчанию 9000 за Caddy)
SELFVOY_PORT=9000
SELFVOY_HOST=0.0.0.0
# Внутренний IP Caddy в docker edge network (для доверенных заголовков X-Forwarded-For)
SELFVOY_TRUSTED_PROXIES=172.30.0.10

# --- 2. БАЗА ДАННЫХ POSTGRESQL ----------------------------------------------
# Пароли для суперпользователя и ролей приложения (сгенерируйте через openssl rand -hex 32)
POSTGRES_PASSWORD=generate_secret_with_openssl_rand_hex_32
SELFVOY_DB_PASSWORD=generate_secret_with_openssl_rand_hex_32
SELFVOY_AI_DB_PASSWORD=generate_secret_with_openssl_rand_hex_32
SELFVOY_DB_POOL_SIZE=16

# --- 3. КРИПТОГРАФИЯ И БЕЗОПАСНОСТЬ ------------------------------------------
# Секретный ключ подписи JWT токенов (не менее 32 байт / 64 hex-символа)
SELFVOY_JWT_SECRET=generate_secret_with_openssl_rand_hex_32
# Ключ шифрования TOTP секретов 2FA (AES-256)
SELFVOY_2FA_KEY=generate_secret_with_openssl_rand_hex_32
# Внутренний токен межсервисного взаимодействия с AI-контейнером
SELFVOY_AI_TOKEN=generate_secret_with_openssl_rand_hex_32

# Уровень логирования: error, warn, info, debug
SELFVOY_LOG_LEVEL=info
# Защита от брутфорса: макс. попыток входа и окно в секундах
SELFVOY_MAX_LOGIN_ATTEMPTS=5
SELFVOY_LOGIN_WINDOW=900
SELFVOY_MAX_CONNECTIONS=2048

# Email адреса первых администраторов (через запятую)
SELFVOY_ADMIN_EMAILS=admin@yourdomain.com

# --- 4. OAUTH 2.0 ПРОВАЙДЕРЫ (Вход в 1 клик) ---------------------------------
# Redirect URI для всех провайдеров в их консолях разработчиков:
#   https://api.yourdomain.com/auth/oauth/callback (или deep link для мобильных)

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
SELFVOY_OAUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SELFVOY_OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
SELFVOY_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SELFVOY_GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (GitHub -> Settings -> Developer Settings -> OAuth Apps)
SELFVOY_GITHUB_CLIENT_ID=your-github-client-id
SELFVOY_GITHUB_CLIENT_SECRET=your-github-client-secret

# Яндекс ID (https://oauth.yandex.ru -> Создать приложение)
SELFVOY_YANDEX_CLIENT_ID=your-yandex-client-id
SELFVOY_YANDEX_CLIENT_SECRET=your-yandex-client-secret

# VK ID (https://id.vk.com / https://vk.com/dev -> Мои приложения)
SELFVOY_VK_CLIENT_ID=your-vk-app-id
SELFVOY_VK_CLIENT_SECRET=your-vk-client-secret

# Discord OAuth (https://discord.com/developers/applications)
SELFVOY_DISCORD_CLIENT_ID=your-discord-client-id
SELFVOY_DISCORD_CLIENT_SECRET=your-discord-client-secret

# ВЫКЛЮЧИТЬ тестовые OAuth-заглушки в продакшене:
SELFVOY_OAUTH_DEV_MOCK=0
SELFVOY_E2E_OAUTH_MOCK=0

# --- 5. ПОЧТОВЫЙ ШЛЮЗ (SMTP) -------------------------------------------------
# Драйвер почты: smtp (для отправки реальных кодов подтверждения и сброса пароля)
SELFVOY_MAIL_DRIVER=smtp
SELFVOY_SMTP_HOST=smtp.yandex.ru
SELFVOY_SMTP_PORT=465
SELFVOY_SMTP_TLS=tls
SELFVOY_SMTP_USER=noreply@yourdomain.com
SELFVOY_SMTP_PASSWORD=your_smtp_app_password
SELFVOY_SMTP_FROM=Selfvoy <noreply@yourdomain.com>

# --- 6. ИСКУССТВЕННЫЙ ИНТЕЛЛЕКТ (LLM) ----------------------------------------
# Провайдер ИИ: openai (также поддерживает DeepSeek, OpenRouter, Groq, vLLM)
SELFVOY_LLM_PROVIDER=openai
# Модель по умолчанию: gpt-4o-mini, deepseek-chat, gpt-4o и т.д.
SELFVOY_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-proj-your-api-key
# Для DeepSeek: https://api.deepseek.com/v1
# Для OpenRouter: https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.openai.com/v1
SELFVOY_LLM_TIMEOUT=30
SELFVOY_RAG_MODE=auto

# --- 7. PUSH-УВЕДОМЛЕНИЯ (FCM & APNs) ----------------------------------------
# Драйвер пушей: webhook (шлёт в push-gateway) или direct
SELFVOY_PUSH_DRIVER=webhook
SELFVOY_PUSH_WEBHOOK_URL=http://push-gateway:8080/push

# Настройки push-gateway:
PUSH_GATEWAY_DEV_MODE=0
# Google Firebase Cloud Messaging (FCM)
FCM_PROJECT_ID=your-firebase-project-id
FCM_ACCESS_TOKEN=your-service-account-oauth-token
# Apple Push Notification service (APNs) для iOS
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
